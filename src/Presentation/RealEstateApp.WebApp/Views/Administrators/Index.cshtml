@model IEnumerable<RealEstateApp.Application.Interfaces.Identity.UserSummary>

@{
    ViewData["Title"] = "Mantenimiento de Administradores";
}

<div class="container mt-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>Administradores</h4>
        <a asp-action="Create" class="btn btn-primary">Crear nuevo administrador</a>
    </div>

    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Correo</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.FirstName</td>
                    <td>@user.LastName</td>
                    <td>@user.Email</td>
                    <td>
                        <span class="badge @(user.IsActive ? "bg-success" : "bg-secondary")">
                            @(user.IsActive ? "Activo" : "Inactivo")
                        </span>
                    </td>
                    <td>
                        <form asp-action="ToggleStatus" method="post" class="d-inline"
                              onsubmit="return confirm('¿Está seguro que desea @(user.IsActive ? "inactivar" : "activar") este administrador?');">
                            <input type="hidden" name="id" value="@user.Id" />
                            <input type="hidden" name="isActive" value="@(!user.IsActive)" />
                            <button type="submit" class="btn btn-sm @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                @(user.IsActive ? "Inactivar" : "Activar")
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
