@model IEnumerable<RealEstateApp.Application.ViewModels.Properties.PropertyViewModel>
@{
    ViewData["Title"] = "Mis propiedades favoritas";
}

<div class="container mt-4">
    <h4>Mis propiedades favoritas</h4>

    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info">@TempData["InfoMessage"]</div>
    }

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var p in Model)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <h5>@p.PropertyTypeName · @p.SaleTypeName</h5>
                        <p>RD$ @p.Price.ToString("N2")</p>
                        <form asp-controller="Client" asp-action="ToggleFavorite" method="post" class="d-inline">
                            <input type="hidden" name="propertyId" value="@p.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">Quitar de favoritas</button>
                        </form>
                        <a asp-action="PropertyDetail" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Ver detalle</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>