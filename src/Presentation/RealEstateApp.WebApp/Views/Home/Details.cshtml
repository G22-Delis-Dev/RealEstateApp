@model RealEstateApp.Application.ViewModels.Properties.PropertyViewModel
@{
    ViewData["Title"] = "Detalle de propiedad";
}

<div class="container mt-4">
    <a asp-action="Index" class="btn btn-link">&larr; Volver</a>

    <div class="row mt-3">
        <div class="col-md-8">
            <div id="carousel" class="carousel slide mb-3">
                <div class="carousel-inner">
                    @for (int i = 0; i < Model.ImageUrls.Count; i++)
                    {
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <img src="@Model.ImageUrls[i]" class="d-block w-100" style="max-height:400px; object-fit:cover;" />
                        </div>
                    }
                </div>
                @if (Model.ImageUrls.Count > 1)
                {
                    <button class="carousel-control-prev" type="button" data-bs-target="#carousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon"></span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#carousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon"></span>
                    </button>
                }
            </div>

            <h3>@Model.PropertyTypeName — @Model.SaleTypeName</h3>
            <h4 class="text-primary">RD$ @Model.Price.ToString("N2")</h4>
            <p>@Model.Rooms habitaciones · @Model.Bathrooms baños · @Model.Size m² · Código: <strong>@Model.Code</strong></p>
            <p>@Model.Description</p>

            <h6>Mejoras</h6>
            <div>
                @foreach (var imp in Model.Improvements)
                {
                    <span class="badge bg-secondary me-1">@imp</span>
                }
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h6>Agente responsable</h6>
                    <p class="text-muted small">Contacte al agente iniciando sesión como Cliente.</p>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary w-100">Iniciar sesión para contactar</a>
                </div>
            </div>
        </div>
    </div>
</div>