@model IEnumerable<string>
@{
    ViewData["Title"] = "Conversaciones";
    int propertyId = ViewBag.PropertyId;
}

<div class="container mt-4">
    <a asp-action="Index" class="btn btn-link">&larr; Volver</a>
    <h4>Clientes con conversación</h4>

    @if (!Model.Any())
    {
        <p class="text-muted">Aún no hay conversaciones para esta propiedad.</p>
    }

    <ul class="list-group">
        @foreach (var clientId in Model)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                Cliente: @clientId
                <a asp-action="Conversation" asp-route-propertyId="@propertyId" asp-route-clientId="@clientId" class="btn btn-sm btn-primary">Ver conversación</a>
            </li>
        }
    </ul>
</div>