@model IEnumerable<RealEstateApp.Application.ViewModels.Agents.AgentListItemViewModel>
@{
    ViewData["Title"] = "Agentes inmobiliarios";
}

<div class="container mt-4">
    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info">@TempData["InfoMessage"]</div>
    }

    <form asp-action="Index" method="get" class="d-flex gap-2 mb-4" style="max-width:400px;">
        <input type="text" name="name" class="form-control" placeholder="Buscar por nombre o apellido" />
        <button type="submit" class="btn btn-primary">Buscar</button>
    </form>

    <div class="row row-cols-1 row-cols-md-4 g-4">
        @foreach (var agent in Model)
        {
            <div class="col text-center">
                <div class="card h-100 p-3">
                    <h6>@agent.FirstName @agent.LastName</h6>
                    <p class="text-muted small">@agent.PropertyCount propiedades</p>
                    <a asp-action="Properties" asp-route-agentId="@agent.Id" class="btn btn-outline-primary btn-sm">Ver propiedades</a>
                </div>
            </div>
        }
    </div>
</div>