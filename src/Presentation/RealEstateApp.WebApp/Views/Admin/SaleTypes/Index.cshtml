@model IEnumerable<RealEstateApp.Application.ViewModels.Catalogs.SaleTypeViewModel>
@{
    ViewData["Title"] = "Tipos de ventas";
}

<div class="container mt-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info">@TempData["InfoMessage"]</div>
    }

    <div class="d-flex justify-content-between mb-3">
        <h4>Tipos de ventas</h4>
        <a asp-action="Create" class="btn btn-primary">Crear tipo de venta</a>
    </div>

    <table class="table table-striped">
        <thead><tr><th>Nombre</th><th>Descripción</th><th>Propiedades</th><th>Acciones</th></tr></thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td>@t.Name</td>
                    <td>@t.Description</td>
                    <td>@t.PropertyCount</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                        <a asp-action="Delete" asp-route-id="@t.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>