@model RealEstateApp.Application.ViewModels.Catalogs.ImprovementViewModel
@{
    ViewData["Title"] = "Crear mejora";
}

<div class="container mt-4">
    <h4>Crear mejora</h4>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label class="form-label">Nombre</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Descripción</label>
            <textarea asp-for="Description" class="form-control"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <a asp-action="Index" class="btn btn-secondary">Volver atrás</a>
        <button type="submit" class="btn btn-primary">Crear mejora</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}